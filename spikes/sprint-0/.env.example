# Sprint 0 only. Copy to .dev.vars for local Wrangler development.
# Never commit .dev.vars or real values.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=
SPIKE_SESSION_SIGNING_SECRET=
ALLOWED_ORIGIN=http://localhost:8787

# Optional for local presence; required to close the Sprint 0 TURN gate.
# Realtime SFU does not consume these credentials.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
