{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "virtual-office-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OfficeRoom"],
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OFFICE_ROOM",
        "class_name": "OfficeRoom",
      },
    ],
  },
  "vars": {
    "APP_ENV": "development",
    "ALLOWED_ORIGIN": "http://localhost:3000",
  },
  "env": {
    "staging": {
      "name": "recuerda-spatial-realtime-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "OFFICE_ROOM",
            "class_name": "OfficeRoom",
          },
        ],
      },
      "vars": {
        "APP_ENV": "staging",
        "ALLOWED_ORIGIN": "https://recuerda-spatial-web-staging.somos-81e.workers.dev",
      },
    },
  },
}
