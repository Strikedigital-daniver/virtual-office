{
  "name": "@virtual-office/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "dev": "next dev",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "lint": "eslint src test next.config.ts open-next.config.ts middleware.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test/sprint-1.e2e.test.ts",
    "test:media-e2e": "node e2e/scripts/generate-fixtures.mjs && playwright test -c e2e/playwright.config.ts e2e/real-media-proximity.spec.ts",
    "test:media-e2e:smoke": "playwright test -c e2e/playwright.config.ts e2e/proximity-presence.spec.ts",
    "test:media-e2e:fixtures": "node e2e/scripts/generate-fixtures.mjs",
    "deploy:staging": "node ../../scripts/with-wrangler-env.mjs staging . opennextjs-cloudflare build --env staging && node ../../scripts/with-wrangler-env.mjs staging . opennextjs-cloudflare deploy --env staging",
    "deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@virtual-office/shared": "0.1.0",
    "next": "16.3.1",
    "phaser": "^3.90.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "wrangler": "^4.123.0"
  }
}
