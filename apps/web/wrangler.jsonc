{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "virtual-office-web",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "virtual-office-web",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "NEXT_PUBLIC_APP_ENV": "development",
    "NEXT_PUBLIC_RECUERDA_APP_URL": "https://recuerda-app-alpha.vercel.app",
  },
  "env": {
    "staging": {
      "name": "recuerda-spatial-web-staging",
      "vars": {
        "NEXT_PUBLIC_APP_ENV": "staging",
        "NEXT_PUBLIC_SUPABASE_URL": "https://wteymdgzlxrfulmoymlx.supabase.co",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_vK6rnIJ3CZfQ1M4GKdLl5A_XiFhnef3",
        "NEXT_PUBLIC_REALTIME_WS_URL": "https://recuerda-spatial-realtime-staging.somos-81e.workers.dev",
        "NEXT_PUBLIC_RECUERDA_APP_URL": "https://recuerda-app-alpha.vercel.app",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "recuerda-spatial-web-staging",
        },
        {
          "binding": "REALTIME_WORKER",
          "service": "recuerda-spatial-realtime-staging",
        },
      ],
    },
  },
}
